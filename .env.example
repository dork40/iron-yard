VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
# Optional HTTPS authority service. It is used only for short-lived authenticated TURN credentials.
# Never add a TURN secret or ticket as a VITE_ variable; see server/README.md.
VITE_AUTHORITY_URL=https://authority.your-domain.example
# Optional for Iron Yard live private 1v1. Offline bot training does not need a server.
# Deploy server/ to a WebSocket-capable host first; Vercel/static hosting serves only this frontend.
VITE_ARENA_SERVER_URL=https://authority.your-domain.example
# Optional static regional directory. This does not create matchmaking or public queues.
# VITE_ARENA_REGIONS=[{"id":"us-east","label":"US East","url":"https://us-east.authority.example"}]
# Optional, only for a separately deployed compatible WebTransport datagram endpoint.
# The bundled Node ws server does not implement WebTransport; WebSocket remains the fallback.
# VITE_ARENA_WEBTRANSPORT_URL=https://wt.authority.your-domain.example/v1/arena
# Developer-only local packet simulation (input, fire, and ping):
# VITE_ARENA_NET_SIMULATION={"latencyMs":80,"jitterMs":15,"lossPercent":2}
